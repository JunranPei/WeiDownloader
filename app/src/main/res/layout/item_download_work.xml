<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="28dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="132dp"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/downloadWorkThumbnail"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@string/download_work_thumbnail"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_media_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Weibo.Thumbnail" />

        <TextView
            android:id="@+id/downloadWorkPlatform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:maxLines="1"
            android:text="Dou"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/downloadWorkThumbnail"
            app:layout_constraintTop_toTopOf="@id/downloadWorkThumbnail" />

        <TextView
            android:id="@+id/downloadWorkAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBaseline_toBaselineOf="@id/downloadWorkPlatform"
            app:layout_constraintEnd_toStartOf="@id/downloadWorkChevron"
            app:layout_constraintStart_toEndOf="@id/downloadWorkPlatform" />

        <ImageView
            android:id="@+id/downloadWorkChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/downloadWorkPlatform"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/downloadWorkTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/downloadWorkThumbnail"
            app:layout_constraintTop_toBottomOf="@id/downloadWorkPlatform" />

        <TextView
            android:id="@+id/downloadWorkStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/downloadWorkThumbnail"
            app:layout_constraintTop_toBottomOf="@id/downloadWorkTitle" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/downloadWorkProgress"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/downloadWorkThumbnail"
            app:layout_constraintTop_toBottomOf="@id/downloadWorkStatus"
            app:trackCornerRadius="2dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
